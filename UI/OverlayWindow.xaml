<Window x:Class="SoundMatrix.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundMatrix"
        Title="SoundMatrix"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White"
        FocusVisualStyle="{x:Null}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- One application square -->
        <DataTemplate x:Key="AppTile" DataType="{x:Type local:AppVM}">
            <Grid x:Name="TileRoot" Width="140" Height="132" Margin="6" Background="Transparent" Cursor="Hand"
                  RenderTransformOrigin="0.5,0.5"
                  Loaded="Tile_Loaded" Unloaded="Tile_Unloaded"
                  MouseLeftButtonDown="Tile_MouseDown" MouseWheel="Tile_MouseWheel">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Grid.RenderTransform>

                <!-- coloured glow, only visible when focused / held -->
                <Border x:Name="Glow" CornerRadius="18" Margin="4" Background="{Binding Device.AccentBrush}" Opacity="0">
                    <Border.Effect>
                        <BlurEffect Radius="26" />
                    </Border.Effect>
                </Border>

                <!-- glass body -->
                <Border x:Name="Glass" CornerRadius="18" Background="{Binding Device.TileBrush}"
                        BorderBrush="{Binding Device.EdgeBrush}" BorderThickness="1">
                    <Grid Margin="12,12,12,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock x:Name="MuteGlyph" DockPanel.Dock="Right" Text="&#xE74F;"
                                       FontFamily="{StaticResource IconFont}" FontSize="16" Opacity="0.9"
                                       VerticalAlignment="Top" Visibility="Collapsed" />
                            <Image Source="{Binding Icon}" Width="30" Height="30" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,6,0,0" />

                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <TextBlock x:Name="MutedLabel" DockPanel.Dock="Right" Text="MUTED" FontSize="10" FontWeight="Bold"
                                       Opacity="0.8" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="VolumeLabel" Text="{Binding VolumeText}" FontSize="22" FontWeight="Light" />
                        </DockPanel>

                        <!-- volume bar with a live peak meter underneath -->
                        <StackPanel Grid.Row="3">
                            <Grid Height="5">
                                <Border CornerRadius="2.5" Background="#26FFFFFF" />
                                <Border x:Name="VolumeFill" CornerRadius="2.5" Background="{Binding Device.AccentBrush}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Volume}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Grid Height="2" Margin="0,3,0,0">
                                <Border Background="#14FFFFFF" CornerRadius="1" />
                                <Border Background="#CCFFFFFF" CornerRadius="1" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Peak}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border CornerRadius="18,18,40,40" Height="46" VerticalAlignment="Top" Margin="1,1,1,0"
                        Background="{StaticResource Sheen}" IsHitTestVisible="False" />

                <Border x:Name="FocusRing" CornerRadius="18" BorderThickness="2" BorderBrush="White"
                        Opacity="0" IsHitTestVisible="False" />

                <Border x:Name="HeldTag" CornerRadius="8" Background="White" Padding="7,2"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-9,0,0" Visibility="Collapsed">
                    <TextBlock Text="MOVING" FontSize="10" FontWeight="Bold" Foreground="#111318" />
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="Glass" Property="Opacity" Value="0.5" />
                    <Setter TargetName="MuteGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="MutedLabel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="VolumeLabel" Property="Opacity" Value="0.5" />
                    <Setter TargetName="VolumeFill" Property="Background" Value="#66FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                    <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeld}" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                    <Setter TargetName="Glow" Property="Opacity" Value="0.95" />
                    <Setter TargetName="HeldTag" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One sound device matrix -->
        <DataTemplate x:Key="DevicePanel" DataType="{x:Type local:DeviceVM}">
            <Grid Margin="16" Width="492">
                <Border x:Name="PanelGlow" CornerRadius="28" Margin="20" Background="{Binding AccentBrush}" Opacity="0.16">
                    <Border.Effect>
                        <BlurEffect Radius="60" />
                    </Border.Effect>
                </Border>

                <Border x:Name="Panel" CornerRadius="28" Background="{Binding PanelBrush}"
                        BorderBrush="{Binding EdgeBrush}" BorderThickness="1" Padding="15,18,15,15">
                    <StackPanel>
                        <DockPanel Margin="6,0,6,12">
                            <Border x:Name="Badge" Width="38" Height="38" CornerRadius="12" Background="{Binding AccentBrush}"
                                    Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding NumberText}" FontSize="20" FontWeight="Bold" Foreground="#0E1015"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTile}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Width="456" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border x:Name="EmptyNote" Height="132" Margin="6" CornerRadius="18" BorderThickness="1"
                                BorderBrush="#33FFFFFF" Background="#0DFFFFFF">
                            <TextBlock Text="Nothing playing here" Opacity="0.55" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="TargetRing" CornerRadius="28" BorderThickness="2" BorderBrush="{Binding AccentBrush}"
                        Opacity="0" IsHitTestVisible="False" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasApps}" Value="True">
                    <Setter TargetName="EmptyNote" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                    <Setter TargetName="TargetRing" Property="Opacity" Value="0.9" />
                    <Setter TargetName="PanelGlow" Property="Opacity" Value="0.35" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.5" />
                                <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Rectangle x:Name="Dim" Fill="Black" Opacity="0.45" MouseLeftButtonDown="Backdrop_MouseDown" />

        <DockPanel Margin="48,40">
            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="SoundMatrix" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="14" Opacity="0.75" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- key hints -->
            <Border DockPanel.Dock="Bottom" HorizontalAlignment="Center" CornerRadius="14" Padding="14,9" Margin="0,16,0,0"
                    Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Hints}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HintVM}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Border CornerRadius="6" Background="#33FFFFFF" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.8" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid>
                <!-- Settings take over this area when open; the matrix is collapsed behind them. -->
                <ContentControl x:Name="SettingsHost" Focusable="False" Visibility="Collapsed" />

                <Grid x:Name="MatrixView">
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" FontSize="16" Opacity="0.75" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                    <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DevicePanel}"
                                  Focusable="False" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Viewbox>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
