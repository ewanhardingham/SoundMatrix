<UserControl x:Class="SoundMatrix.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoundMatrix"
             Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="None">

    <UserControl.Resources>
        <ResourceDictionary Source="GlassStyles.xaml" />
    </UserControl.Resources>

    <!-- Same glass treatment as a device panel, but neutral white. -->
    <Grid MaxWidth="1180">
        <Border CornerRadius="28" BorderThickness="1" Padding="32,28,32,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#26FFFFFF" Offset="0" />
                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80FFFFFF" Offset="0" />
                    <GradientStop Color="#26FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <DockPanel>
                <!-- footer -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button Content="Reset to defaults" Click="Reset_Click" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="ConflictText" Foreground="#FDA4AF" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" />
                        <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <!-- Devices -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Output devices" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="Tick the devices that should get a matrix. Their order sets each device's number (1–9). Click a swatch to change its colour." />
                                    <ItemsControl x:Name="DeviceRows" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:DeviceRow}">
                                                <Border Background="#14FFFFFF" CornerRadius="12" Padding="12,9" Margin="0,3">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up" Click="MoveUp_Click" Tag="{Binding}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down" Click="MoveDown_Click" Tag="{Binding}" />
                                                        </StackPanel>
                                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Margin="0,0,10,0"
                                                                Background="{Binding ColorBrush}">
                                                            <TextBlock Text="{Binding NumberText}" FontWeight="Bold" Foreground="#0E1015"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Button DockPanel.Dock="Left" Width="28" Height="28" Padding="0" Margin="0,0,14,0"
                                                                Content="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                ToolTip="Change colour" Click="Colour_Click" Tag="{Binding}" />
                                                        <CheckBox IsChecked="{Binding Show}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Volume -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Volume step" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Note}" Text="How much the volume up / down keys change an app's level." />
                                    <DockPanel>
                                        <TextBlock x:Name="StepText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Slider x:Name="StepSlider" Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="5" ValueChanged="StepSlider_ValueChanged" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Appearance -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="Background dim" Width="130" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DimText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Slider x:Name="DimSlider" Minimum="0" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                                ValueChanged="DimSlider_ValueChanged" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <CheckBox x:Name="BlurCheck" Content="Blur whatever is behind the overlay" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hotkeys -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCard}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Hotkeys" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Note}"
                                           Text="Select a key, then press the new combination. Open / close works anywhere in Windows; the rest work while the overlay is open. Number keys 1–9 always choose a device." />
                                <ItemsControl x:Name="HotkeyRows" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:HotkeyRow}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Problem}" Foreground="#FDA4AF" FontSize="11" TextWrapping="Wrap"
                                                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Button x:Name="KeyButton" Grid.Column="1" Content="{Binding Display}" Click="Capture_Click" Tag="{Binding}"
                                                        FontFamily="Cascadia Mono, Consolas" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Reset to default"
                                                        Click="ResetHotkey_Click" Tag="{Binding}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter TargetName="KeyButton" Property="BorderBrush" Value="#FDA4AF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter TargetName="KeyButton" Property="Background" Value="#4D60A5FA" />
                                                    <Setter TargetName="KeyButton" Property="BorderBrush" Value="#93C5FD" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
